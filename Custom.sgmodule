#!url=https://raw.githubusercontent.com/psikent/rule/refs/heads/main/Custom.sgmodule
#!name=🔗Custom
#!category=1️⃣本地定制
#!desc=自定义规则与脚本，会出现在rule顶部，优先级最高（含 NAS 分流解析 + 开关检测三合一脚本）
[Rule]
DOMAIN,userlocations.googleapis.com,美国策略-SELECT,extended-matching  // google地理位置判断
#
# REJECT
IP-CIDR,194.221.250.50/32,REJECT-DROP,pre-matching,no-resolve  // telegram阻断劣质节点
IP-CIDR,0.0.0.0/32,REJECT,pre-matching,no-resolve  // 防止应用循环请求
AND,((DOMAIN-SUFFIX,xiaohongshu.com,extended-matching), (DEST-PORT,443), (PROTOCOL,UDP)),REJECT  // 小红书阻断QUIC
DOMAIN,a.f-0.cc,REJECT,pre-matching  // 磨题帮广告
DOMAIN,mssdk.volces.com,REJECT,pre-matching  // 磨题帮广告
DOMAIN,log-api.pangolin-sdk-toutiao-b.com,REJECT,pre-matching  // 磨题帮广告
DOMAIN,autoupdate.termius.com,REJECT,pre-matching  // 禁止termius自动更新
# 【强力】拦截字节系通用广告联盟 (底部横幅)
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT,pre-matching
DOMAIN-SUFFIX,bytegecko.com,REJECT,pre-matching
# 【强力】拦截字节系广告配置 (你要求加的 snssdk 和 zijieapi)
DOMAIN-SUFFIX,snssdk.com,REJECT,pre-matching
DOMAIN-SUFFIX,zijieapi.com,REJECT,pre-matching
# 【辅助】拦截第三方追踪与推广
DOMAIN-SUFFIX,dig.bdurl.net,REJECT,pre-matching
#
# DIRECT
AND,((DEST-PORT,123), (PROTOCOL,UDP)),DIRECT  // 对时
DOMAIN-SUFFIX,istrongcloud.com,DIRECT,extended-matching  // 台风预警
DOMAIN,fairplay.l.qq.com,DIRECT,extended-matching  // 腾讯视频超前点播
DOMAIN,cache.video.iqiyi.com,DIRECT,extended-matching  // 爱奇艺
DOMAIN,hudong.alicdn.com,DIRECT,extended-matching  // 支付宝跳转淘宝
DOMAIN,ib.snssdk.com,DIRECT,extended-matching  // 今日头条白名单
DOMAIN-SUFFIX,ip.sb,DIRECT,extended-matching  // ip测试
DOMAIN-SUFFIX,plex.tv,DIRECT,extended-matching  // Plex
DOMAIN-SUFFIX,plex.direct,DIRECT,extended-matching  // Plex
#
# lxj.ink 业务
DOMAIN,substore.lxj.ink,香港策略-SELECT,extended-matching  // Added for: substore.lxj.ink:443
DOMAIN,nas.lxj.ink,DIRECT,extended-matching
DOMAIN,workplan.lxj.ink,DIRECT,extended-matching
# 分流香港
DOMAIN-SUFFIX,appinn.net,香港策略-SELECT,extended-matching
# 分流日本
DOMAIN-SUFFIX,dmm.com,日本策略-SELECT,extended-matching
# 分流美国
DOMAIN-SUFFIX,reddit.com,美国策略-SELECT,extended-matching  // reddit

[Script]
nas-split = type=dns, script-path=scripts/nas-split.js, engine=jsc
开关检测三合一 = type=cron, cronexp="*/30 * * * *", script-path=scripts/开关检测三合一.js, timeout=30, argument="notification=true", engine=jsc

[Host]
nas.lxj.ink = script:nas-split
